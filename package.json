{
  "name": "advisory-scan-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, and so markdownlint and Prettier are pinned like everything else.",
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "katex": "0.18.11",
    "markdown-it": "14.3.2",
    "smol-toml": "1.9.1"
  }
}
